{
	"name": "cwxeditor",
	"description": "A CardWirth Editor for CardWirth 1.28-1.50 and WSN.",
	"license": "CC0",
	"authors": [
		"k4nagatsuki"
	],

	"targetName": "cwxeditor",
	"targetType": "executable",
	"application": "cwxeditor.d",

	"dependencies": {
		":core": "*",
		":gui": "*",
		":extlib": "*"
	},
	"subPackages": [
		{
			"name": "core",
			"targetType": "library",

			"sourcePaths": [
				"core"
			],
			"importPaths": [
				"core",
				"extlib"
			],
			"stringImportPaths": [
				"."
			],
			"dependencies": {
				"dxml": ">=0.4.3"
			}
		},
		{
			"name": "gui",
			"targetType": "library",

			"sourcePaths": [
				"gui"
			],
			"importPaths": [
				"core",
				"gui",
				"extlib"
			],
			"stringImportPaths": [
				".",
				"resource"
			],
			"dflags-dmd": [
				"-lowmem"
			],
			"dependencies": {
				"dxml": ">=0.4.3",
				"dwt": ">=1.0.5"
			}
		},
		{
			"name": "extlib",
			"targetType": "library",

			"sourcePaths": [
				"extlib"
			],
			"importPaths": [
				"core",
				"extlib"
			]
		}
	],

	"excludedSourceFiles": [
		"build.d",
		"createrc.d",
		"private/*"
	],

	"preBuildCommands-windows-x86": [
		"rdmd -J. createrc.d",
		"rcc cwxeditor.rc"
	],
	"lflags-windows-x86": [
		"/rc:cwxeditor.res"
	],

	"preBuildCommands-windows-x86_64": [
		"rdmd -J. createrc.d",
		"rc cwxeditor.rc"
	],
	"lflags-windows-x86_64": [
		"cwxeditor.res",
		"/STACK:4194304"
	],
	"libs-linux": [
		"atk-1.0",
		"cairo",
		"dl",
		"fontconfig",
		"gdk-x11-2.0",
		"gdk_pixbuf-2.0",
		"glib-2.0",
		"gmodule-2.0",
		"gnomeui-2",
		"gnomevfs-2",
		"gobject-2.0",
		"gthread-2.0",
		"gtk-x11-2.0",
		"pango-1.0",
		"pangocairo-1.0",
		"X11",
		"Xcomposite",
		"Xcursor",
		"Xdamage",
		"Xext",
		"Xfixes",
		"Xi",
		"Xinerama",
		"Xrandr",
		"Xrender",
		"Xtst"
	],

	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode"
			],
			"buildOptions-x86_64": [
				"debugMode",
				"debugInfo"
			],
			"versions": [
				"Console"
			]
		},
		"gui": {
			"buildOptions": [
				"debugMode"
			],
			"buildOptions-x86_64": [
				"debugMode",
				"debugInfo"
			],
			"lflags-windows-x86": [
				"/exet:nt/su:windows:4.0"
			],
			"lflags-windows-x86_64": [
				"/SUBSYSTEM:Windows",
				"/ENTRY:mainCRTStartup"
			]
		},
		"release": {
			"buildOptions": [
				"releaseMode"
			],
			"lflags-windows-x86": [
				"/exet:nt/su:windows:4.0"
			],
			"lflags-windows-x86_64": [
				"/SUBSYSTEM:Windows",
				"/ENTRY:mainCRTStartup"
			]
		}
	}
}
