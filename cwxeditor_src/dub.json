{
	"name": "cwxeditor",
	"description": "A CardWirth Editor for CardWirth 1.28-1.50 and WSN.",
	"license": "CC0",
	"authors": [
		"k4nagatsuki"
	],

	"targetName": "cwxeditor",
	"targetType": "executable",
	"application": "cwx/editor/gui/dwt/cwxeditor.d",

	"sourcePaths": [
		"."
	],
	"excludedSourceFiles": [
		"build.d",
		"createrc.d",
		"private/*"
	],
	"stringImportPaths": [
		".",
		"resource"
	],
	"dependencies": {
		"dwt": "~>1.0.4",
		"dxml": "~>0.4.1"
	},

	"preBuildCommands-windows-x86": [
		"rdmd -J. createrc.d",
		"rcc cwxeditor.rc"
	],
	"lflags-windows-x86": [
		"/rc:cwxeditor.res",
		"bassloop32.obj"
	],

	"preBuildCommands-windows-x86_64": [
		"rdmd -J. createrc.d",
		"rc cwxeditor.rc"
	],
	"lflags-windows-x86_64": [
		"cwxeditor.res",
		"bassloop64.obj",
		"-L/STACK:4194304"
	],
	"libs-linux": [
		"atk-1.0",
		"cairo",
		"dl",
		"fontconfig",
		"gdk-x11-2.0",
		"gdk_pixbuf-2.0",
		"glib-2.0",
		"gmodule-2.0",
		"gnomeui-2",
		"gnomevfs-2",
		"gobject-2.0",
		"gthread-2.0",
		"gtk-x11-2.0",
		"pango-1.0",
		"pangocairo-1.0",
		"X11",
		"Xcomposite",
		"Xcursor",
		"Xdamage",
		"Xext",
		"Xfixes",
		"Xi",
		"Xinerama",
		"Xrandr",
		"Xrender",
		"Xtst"
	],

	"buildTypes": {
		"debug": {
			"buildOptions": [
				"debugMode",
				"debugInfo"
			],
			"versions": [
				"Console"
			]
		},
		"gui": {
			"buildOptions": [
				"debugMode",
				"debugInfo"
			],
			"lflags-windows-x86": [
				"/exet:nt/su:windows:4.0"
			],
			"lflags-windows-x86_64": [
				"/SUBSYSTEM:Windows",
				"/ENTRY:mainCRTStartup"
			]
		},
		"release": {
			"buildOptions": [
				"releaseMode",
				"optimize",
				"inline"
			],
			"lflags-windows-x86": [
				"/exet:nt/su:windows:4.0"
			],
			"lflags-windows-x86_64": [
				"/SUBSYSTEM:Windows",
				"/ENTRY:mainCRTStartup"
			]
		}
	}
}
